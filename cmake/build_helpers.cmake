include(CheckIPOSupported)

function(add_default_warnings tgt)
  if(MSVC)
    target_compile_options(${tgt} PRIVATE /W4 /utf-8)
  else()
    target_compile_options(${tgt} PRIVATE -Wall -Wextra -Wpedantic)
  endif()
  find_program(SCCACHE_PROGRAM sccache)
  find_program(CCACHE_PROGRAM ccache)
  if(SCCACHE_PROGRAM)
    set_property(TARGET ${tgt} PROPERTY CXX_COMPILER_LAUNCHER ${SCCACHE_PROGRAM})
    set_property(TARGET ${tgt} PROPERTY C_COMPILER_LAUNCHER ${SCCACHE_PROGRAM})
  elseif(CCACHE_PROGRAM)
    set_property(TARGET ${tgt} PROPERTY CXX_COMPILER_LAUNCHER ${CCACHE_PROGRAM})
    set_property(TARGET ${tgt} PROPERTY C_COMPILER_LAUNCHER ${CCACHE_PROGRAM})
  endif()
endfunction()

function(enable_ipo_for_release)
  check_ipo_supported(RESULT ipo_ok)
  if(ipo_ok)
    set(CMAKE_INTERPROCEDURAL_OPTIMIZATION_RELEASE ON PARENT_SCOPE)
  endif()
endfunction()
